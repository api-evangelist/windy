          "id": "b4f7aab9-e4b7-4bed-aebe-42e60e7e8b1c",
          "name": "List and filter webcams.",
          "request": {
            "name": "List and filter webcams.",
            "description": {
              "content": "Returns a paginated list of webcams. Results can be filtered by category, country, continent, region, and bounding box, and enriched with optional includes such as images, location, player, and urls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "webcams",
                "api",
                "v3",
                "webcams"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lang",
                  "value": "en",
                  "description": "Language code for localized strings (e.g. en, de, es)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "10",
                  "description": "Maximum number of webcams to return (max 50)."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Offset for pagination. Max offset is 1000 (free) or 10000 (professional)."
                },
                {
                  "disabled": false,
                  "key": "categories",
                  "value": "<string>",
                  "description": "Comma-separated list of category slugs to filter by."
                },
                {
                  "disabled": false,
                  "key": "continents",
                  "value": "<string>",
                  "description": "Comma-separated list of continent codes to filter by."
                },
                {
                  "disabled": false,
                  "key": "countries",
                  "value": "<string>",
                  "description": "Comma-separated list of ISO country codes to filter by."
                },
                {
                  "disabled": false,
                  "key": "regions",
                  "value": "<string>",
                  "description": "Comma-separated list of region codes to filter by."
                },
                {
                  "disabled": false,
                  "key": "nearby",
                  "value": "<string>",
                  "description": "Filter to webcams near a point, as \"lat,lon,radius\" in km."
                },
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated list of detail objects to include in each webcam: categories, images, location, player, urls."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "x-windy-api-key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
